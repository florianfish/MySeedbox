<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ : allowBackup=false ne couvre que la sauvegarde cloud. Rien ne part non plus lors d'un
     transfert vers un nouveau téléphone (adresses de la seedbox ; secrets illisibles sans la clé du Keystore). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
